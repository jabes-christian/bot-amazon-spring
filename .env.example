# Copie para .env e preencha com valores reais. .env nao e versionado (ver .gitignore).

# Postgres
DB_URL=jdbc:postgresql://localhost:5432/bot_amazon
DB_USER=postgres
DB_PASSWORD=troque-me

# Telegram
TELEGRAM_BOT_TOKEN=coloque-o-token-do-bot-aqui

# Evolution API (WhatsApp)
EVOLUTION_API_URL=https://sua-instancia-evolution.example.com
EVOLUTION_API_KEY=coloque-a-api-key-aqui
EVOLUTION_API_INSTANCE=nome-da-instancia

# OpenRouter (LLM)
OPENROUTER_API_KEY=coloque-a-api-key-aqui
OPENROUTER_MODEL=coloque-o-nome-do-modelo-aqui

# Amazon / afiliados
AFILIADO_TAG=sua-tag-de-afiliado-20

# Selenium (vazio = ChromeDriver local; preenchido = RemoteWebDriver)
SELENIUM_REMOTE_URL=
